rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email in ['bhuvanmbhuvanm15@gmail.com', 'scoders82@gmail.com'])
      );
    }

    function validEmail(val) {
      return val is string &&
        val.size() >= 3 &&
        val.size() <= 180 &&
        val.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validStringLen(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUserPublic(data) {
      return data.keys().hasAll(['displayName', 'role', 'updatedAt']) &&
        data.keys().hasOnly(['displayName', 'role', 'updatedAt']) &&
        validStringLen(data.displayName, 1, 120) &&
        data.role in ['client', 'admin'] &&
        (isAdmin() || data.role == 'client') &&
        data.updatedAt == request.time;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['email', 'updatedAt']) &&
        data.keys().hasOnly(['email', 'phone', 'company', 'linkedUids', 'updatedAt']) &&
        validEmail(data.email) &&
        (!('phone' in data) || validStringLen(data.phone, 0, 40)) &&
        (!('company' in data) || validStringLen(data.company, 0, 180)) &&
        (!('linkedUids' in data) || (data.linkedUids is list && data.linkedUids.size() <= 50)) &&
        data.updatedAt == request.time;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll([
          'ownerUid',
          'uid',
          'section',
          'itemId',
          'itemTitle',
          'clientName',
          'clientEmail',
          'amount',
          'paymentStatus',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'uid',
          'section',
          'itemId',
          'itemTitle',
          'clientName',
          'clientEmail',
          'clientPhone',
          'clientRole',
          'requirements',
          'notes',
          'budget',
          'timeline',
          'amount',
          'paymentStatus',
          'paymentId',
          'status',
          'chatId',
          'issuedAt',
          'validUntil',
          'createdAt',
          'updatedAt'
        ]) &&
        validStringLen(data.ownerUid, 1, 128) &&
        data.uid is string &&
        data.uid.matches('^[A-Z0-9-]{4,64}$') &&
        data.section in ['service', 'workshop', 'event'] &&
        validStringLen(data.itemId, 1, 120) &&
        validStringLen(data.itemTitle, 1, 200) &&
        validStringLen(data.clientName, 1, 120) &&
        validEmail(data.clientEmail) &&
        (!('clientPhone' in data) || validStringLen(data.clientPhone, 0, 40)) &&
        (!('clientRole' in data) || validStringLen(data.clientRole, 0, 180)) &&
        (!('requirements' in data) || validStringLen(data.requirements, 0, 2000)) &&
        (!('notes' in data) || validStringLen(data.notes, 0, 2000)) &&
        (!('budget' in data) || validStringLen(data.budget, 0, 100)) &&
        (!('timeline' in data) || validStringLen(data.timeline, 0, 100)) &&
        (data.amount is int || data.amount is float) &&
        data.amount >= 0 &&
        data.amount <= 10000000 &&
        data.paymentStatus in ['VERIFIED', 'NOT_REQUIRED', 'PENDING'] &&
        (!('paymentId' in data) || validStringLen(data.paymentId, 0, 120)) &&
        data.status in ['ACTIVE', 'EXPIRED', 'REVOKED'] &&
        (!('chatId' in data) || validStringLen(data.chatId, 0, 120)) &&
        (!('issuedAt' in data) || validStringLen(data.issuedAt, 0, 64)) &&
        (!('validUntil' in data) || validStringLen(data.validUntil, 0, 64)) &&
        data.updatedAt == request.time;
    }

    function ownerRegistrationImmutableFieldsUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.section == resource.data.section &&
        request.resource.data.itemId == resource.data.itemId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!('paymentId' in resource.data) || request.resource.data.paymentId == resource.data.paymentId) &&
        (!('chatId' in resource.data) || request.resource.data.chatId == resource.data.chatId) &&
        (!('issuedAt' in resource.data) || request.resource.data.issuedAt == resource.data.issuedAt) &&
        (!('validUntil' in resource.data) || request.resource.data.validUntil == resource.data.validUntil) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientName',
          'clientEmail',
          'clientPhone',
          'clientRole',
          'requirements',
          'notes',
          'budget',
          'timeline',
          'itemTitle',
          'updatedAt'
        ]);
    }

    // =========================================================================
    // Collections
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserPublic(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidUserPublic(request.resource.data);
      allow delete: if isAdmin();

      match /private/{docId} {
        allow get: if (isOwner(userId) || isAdmin()) && docId == 'info';
        allow list: if false;
        allow create: if isOwner(userId) && docId == 'info' && isValidUserPrivate(request.resource.data);
        allow update: if isOwner(userId) && docId == 'info' && isValidUserPrivate(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    match /registrations/{registrationId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        registrationId.matches('^[A-Za-z0-9_-]{4,140}$') &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        isValidRegistration(request.resource.data);
      allow update: if isSignedIn() &&
        isValidRegistration(request.resource.data) &&
        (
          isAdmin() ||
          (resource.data.ownerUid == request.auth.uid && ownerRegistrationImmutableFieldsUnchanged())
        );
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow write: if false;
    }

    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
