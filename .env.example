GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=scoders82@gmail.com
SMTP_PASS=
SMTP_FROM="S-CODERS (Bharat Tech Developers) <scoders82@gmail.com>"

